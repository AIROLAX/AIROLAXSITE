{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node tools/vercelInstall.mjs",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/videos/:path*",
      "destination": "https://mail.airolax.com/videos/:path*"
    },
    {
      "source": "/videos-compressed/:path*",
      "destination": "https://mail.airolax.com/videos-compressed/:path*"
    },
    {
      "source": "/collections/generative-video/previews/:path*",
      "destination": "https://mail.airolax.com/collections/generative-video/previews/:path*"
    },
    {
      "source": "/collections/immersive-installation/previews/:path*",
      "destination": "https://mail.airolax.com/collections/immersive-installation/previews/:path*"
    },
    {
      "source": "/collections/projection-mapping/previews/:path*",
      "destination": "https://mail.airolax.com/collections/projection-mapping/previews/:path*"
    },
    {
      "source": "/collections/sound/previews/:path*",
      "destination": "https://mail.airolax.com/collections/sound/previews/:path*"
    }
  ]
}
