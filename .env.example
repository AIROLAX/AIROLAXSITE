# Copy to .env locally. In Vercel: Project → Settings → Environment Variables.
# Prefix VITE_ is required for Vite to expose vars to the browser bundle.

# Google Analytics 4 (optional — leave empty to disable GA on the main bundle)
VITE_GA_MEASUREMENT_ID=G-RWP8TWF8QX

# Large videos: leave EMPTY on Vercel (site uses /videos + rewrites to cPanel).
# Do NOT set https://airolax.com — that loops to the same deploy.
# Optional CDN/subdomain only: https://media.airolax.com
VITE_MEDIA_BASE_URL=
